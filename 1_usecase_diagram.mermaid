%% ============================================================
%%  EDU System – Use Case Diagram
%%  Students enter school results to search for universities
%%  + Chat system for university inquiries
%% ============================================================
graph TB
    %% ── Actors ────────────────────────────────────────────
    PubStudent(["👤 Public School\nStudent"])
    AmerStudent(["👤 American School\nStudent"])
    PrivStudent(["👤 Private School\nStudent"])
    UniRep(["👤 University\nRepresentative"])
    Admin(["👤 System Admin"])
    System(["🤖 EDU System"])

    subgraph EDU ["🎓 EDU – University Search & Chat System"]

        %% ── Registration & Profile ───────────────────────
        UC1["Register Account"]
        UC2["Login / Logout"]
        UC3["Select School Type\n(Public / American / Private)"]
        UC4["Complete Student Profile"]

        %% ── Academic Data Entry ──────────────────────────
        UC5["Enter Public School Results\n(National Exam Grades)"]
        UC6["Enter American School Results\n(SAT / ACT / GPA)"]
        UC7["Enter Private School Results\n(IB / IGCSE / A-Level)"]
        UC8["Upload Supporting Documents\n(Transcripts / Certificates)"]
        UC9["Edit / Update Academic Data"]

        %% ── University Search ────────────────────────────
        UC10["Search for Universities"]
        UC11["Filter by Location"]
        UC12["Filter by University Type\n(Public / Private)"]
        UC13["Filter by Tuition Fees Range"]
        UC14["Filter by Available Programs"]
        UC15["View University Profile\n(Details, Fees, Requirements)"]
        UC16["Check Admission Eligibility\n(Match Results to Requirements)"]
        UC17["Save / Bookmark Universities"]
        UC18["Compare Universities"]

        %% ── Chat System ──────────────────────────────────
        UC19["Start Chat with University Rep"]
        UC20["Ask About Location & Campus"]
        UC21["Ask About Tuition Fees"]
        UC22["Ask About Programs & Majors"]
        UC23["Ask About Admission Requirements"]
        UC24["Receive Automated FAQ Answers"]
        UC25["View Chat History"]

        %% ── Application ──────────────────────────────────
        UC26["Submit University Application"]
        UC27["Track Application Status"]
        UC28["Receive Acceptance Notification"]

        %% ── University Rep ───────────────────────────────
        UC29["Manage University Profile"]
        UC30["Respond to Student Chats"]
        UC31["View Student Applicants"]
        UC32["Update Admission Requirements"]

        %% ── Admin ────────────────────────────────────────
        UC33["Manage Users & Accounts"]
        UC34["Add / Manage Universities"]
        UC35["Monitor Chat System"]
        UC36["Generate Reports"]
        UC37["Manage School Grading Systems"]

        %% ── System Auto ──────────────────────────────────
        UC38["Auto-Match Student to Universities"]
        UC39["Send Notification / Alert"]
    end

